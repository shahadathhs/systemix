{
  "name": "@systemix/eslint",
  "version": "0.4.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Shareable ESLint v10 flat configs for JavaScript, TypeScript, React, Express, and Next.js. Part of the Systemix toolkit.",
  "keywords": [
    "systemix",
    "eslint",
    "eslint-config",
    "eslint-flat-config",
    "typescript",
    "react",
    "nextjs",
    "express",
    "lint",
    "code-quality"
  ],
  "author": "Shahadath Hossen Sajib <shahadathhossensajib732@gmail.com> (https://github.com/shahadathhs)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shahadathhs/systemix.git",
    "directory": "configs/eslint"
  },
  "homepage": "https://github.com/shahadathhs/systemix/tree/main/configs/eslint#readme",
  "bugs": {
    "url": "https://github.com/shahadathhs/systemix/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    "./base": "./base.js",
    "./express": "./express.js",
    "./next": "./next.js",
    "./next-minimal": "./next-minimal.js",
    "./base.js": "./base.js",
    "./express.js": "./express.js",
    "./next.js": "./next.js",
    "./next-minimal.js": "./next-minimal.js"
  },
  "files": [
    "*.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf node_modules",
    "clean:turbo": "rimraf .turbo node_modules"
  },
  "dependencies": {
    "@eslint/js": "catalog:",
    "@next/eslint-plugin-next": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-only-warn": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-turbo": "catalog:",
    "globals": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
