{
  "name": "demos",
  "version": "0.1.0",
  "private": true,
  "description": "Live documentation and interactive demos for Systemix packages.",
  "author": "Shahadath Hossen Sajib <shahadathhossensajib732@gmail.com> (https://github.com/shahadathhs)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shahadathhs/systemix.git",
    "directory": "demos"
  },
  "homepage": "https://github.com/shahadathhs/systemix/tree/main/demos#readme",
  "bugs": {
    "url": "https://github.com/shahadathhs/systemix/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check . --ignore-path .prettierignore",
    "format:fix": "prettier --write . --ignore-path .prettierignore",
    "clean": "rimraf .next node_modules",
    "clean:turbo": "rimraf .turbo .next node_modules"
  },
  "dependencies": {
    "@mdx-js/loader": "catalog:",
    "@mdx-js/react": "catalog:",
    "@next/mdx": "catalog:",
    "@systemix/env": "workspace:*",
    "@systemix/passphrase": "workspace:*",
    "@systemix/password": "workspace:*",
    "@systemix/token": "workspace:*",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rehype-slug": "catalog:",
    "remark-gfm": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@systemix/eslint": "workspace:*",
    "@systemix/typescript": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
}
