{
  "name": "@systemix/build-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal TypeScript build tool for Systemix monorepo",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "systemix-build": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "dev:cli": "tsc --watch && node dist/cli.js --entry src/index.ts --outDir dist --clean"
  },
  "dependencies": {
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@systemix/typescript": "workspace:*",
    "@types/node": "catalog:"
  }
}